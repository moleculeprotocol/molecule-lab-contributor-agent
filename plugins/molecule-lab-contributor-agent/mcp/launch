#!/bin/sh
# Starts the mol-labs MCP server on macOS and Linux. .mcp.json points here.
#
# On Windows the same .mcp.json entry resolves to cmd.exe running launch.cmd instead, and
# the two arguments Claude Code passes ("/c" and the path of launch.cmd) are for that case;
# this script ignores them.
#
# The job here is to make the very first spawn succeed. Claude Code starts this process at
# the same moment the SessionStart hook begins first-time setup, and a spawn that fails is
# remembered for fifteen minutes. So: if setup is running, wait for it; if it never ran, do
# it here; then hand over to the private uv. Nothing may be written to stdout — that is the
# MCP channel — so every message goes to stderr or the log.

set -u

# As a plugin, the host sets both of these. Run any other way — a developer working on this
# repository, or an MCP client that passes no plugin variables, Codex included — they are
# unset, and the root is then this plugin folder (the parent of mcp/, i.e.
# plugins/molecule-lab-contributor-agent, NOT the repository root) with a gitignored
# .plugin-data inside it. Both are exported below, so the server always knows its own home.
ROOT="${CLAUDE_PLUGIN_ROOT:-$(cd "$(dirname "$0")/.." && pwd)}"
DATA="${CLAUDE_PLUGIN_DATA:-$ROOT/.plugin-data}"

# Hand both to the server as environment variables, not just as shell variables local to
# this script. Claude Code puts them in the spawned process's environment itself, so this
# is a no-op there. Every other MCP host is the reason it is here: they substitute these
# tokens into the strings of the server entry and stop, leaving the process itself without
# them. The server then has no persistent home — it falls back to a .env resolved against
# whatever directory the host happened to launch from, and agent_wallet(create=True)
# refuses to generate a key rather than put one somewhere that will not be found again.
export CLAUDE_PLUGIN_ROOT="$ROOT"
export CLAUDE_PLUGIN_DATA="$DATA"

UV="$DATA/uv/uv"
LOCK="$DATA/bootstrap.lock"
SERVER="$ROOT/mcp/server.py"

wait_for_setup() {
  n=0
  while [ -d "$LOCK" ] && [ "$n" -lt 600 ]; do
    sleep 1
    n=$((n + 1))
  done
}

wait_for_setup
if [ ! -x "$UV" ]; then
  # The hook has not run (hooks disabled, or a plain `claude --plugin-dir` before the hook
  # fired). Run setup here; its stdout is meant for the agent, so send it to stderr.
  CLAUDE_PLUGIN_ROOT="$ROOT" CLAUDE_PLUGIN_DATA="$DATA" sh "$ROOT/mcp/bootstrap.sh" 1>&2
  wait_for_setup
fi
if [ ! -x "$UV" ]; then
  echo "mol-labs: no usable uv at $UV — see $DATA/bootstrap.log" 1>&2
  exit 1
fi

exec "$UV" run --script "$SERVER"
