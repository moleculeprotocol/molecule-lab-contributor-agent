# Copy to .env and fill in. .env is gitignored — never commit a filled-in copy.
# Loaded by uv:
#   uv run --env-file .env skills/molecule-lab-contributor/scripts/agent_upload.py …

# --- required ---

# Which app the human created their Lab in. LEAVE THIS BLANK until they tell you: a Lab
# that exists in one environment is invisible in the other, and a wrong guess produces a
# NOT_FOUND that reads like a bad OCL_ID.
#   staging     -> testnet.labs.molecule.xyz  (Base Sepolia)
#   production  -> labs.molecule.xyz          (Base)
MOLECULE_ENV=

# Your consumer credential, from the Molecule team. Sent verbatim as the
# Authorization header — no "Bearer" prefix, and never alongside x-api-key.
CONSUMER_CREDENTIAL=mol_<consumerId>_<secret>

# The Lab you were granted a role on — its canonical 32-byte id, from the app.
OCL_ID=0x0101...

# The agent's own private key. Generate it ONCE:
#   uv run skills/molecule-lab-contributor/scripts/agent_upload.py --key-out ./.agent-key
# then keep it. A new key is a different agent with no role on the Lab, and the owner
# would have to grant the role again.
#
# This is the AGENT's key. It is never the human's wallet key, and it needs no funds.
# It must be a plain EOA — sign-in cannot verify a smart-contract account.
AGENT_PRIVATE_KEY=

# --- optional ---

# Identifies this agent on its service token, and is how the human tells your token apart
# from other agents' when revoking. Leave it unset for a unique address-derived name;
# set something task-specific like assay-round-3-upload if you prefer. Do NOT reuse one
# name across concurrent agents — sign-in nonces are per (wallet, serviceName) and the
# second run clobbers the first.
# SERVICE_NAME=

# Service-token lifetime, <int><unit>, between 1 hour and 2 years.
# Use only s, m, h, d, w. The "M" unit is read as MINUTES by the token signer while the
# API reports it back as months, so "6M" dies in six minutes.
# EXPIRES_IN=30d

# Read-only Base RPC, used by the private path to check the access conditions are
# evaluatable before encrypting. Defaults to the public node for the chosen environment.
# EVM_RPC_URL=https://sepolia.base.org
