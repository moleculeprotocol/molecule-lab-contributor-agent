# Copy to .env and fill in. .env is gitignored — never commit a filled-in copy.
# Load it with Node's built-in flag (no dependency):
#   node --env-file=.env agent-upload.mjs ./findings.csv

# --- required ---

# Your consumer credential, from the Molecule team. Sent verbatim as the
# Authorization header — no "Bearer" prefix, and never alongside x-api-key.
CONSUMER_CREDENTIAL=mol_<consumerId>_<secret>

# The Lab you were granted a role on — its canonical 32-byte id, from the app.
OCL_ID=0x0101...

# The agent's own private key. Generate it ONCE (phase 1 of the skill prints one),
# then keep it here: a new key is a different agent, with no role on the Lab, and
# the owner would have to grant the role again.
# This is the AGENT's key. It is never the human's wallet key, and it needs no funds.
AGENT_PRIVATE_KEY=0x...

# --- optional ---

# Identifies this agent on its service token. Free-form.
SERVICE_NAME=research-agent-1

# Defaults are staging. Uncomment to target production instead.
# GRAPHQL_URL=https://production.graphql.api.molecule.xyz/graphql
# LAB_APP_URL=https://labs.molecule.xyz
